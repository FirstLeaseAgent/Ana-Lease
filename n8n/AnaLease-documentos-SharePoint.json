{
  "name": "AnaLease - Documentos SharePoint (piloto)",
  "nodes": [
    {
      "id": "entrada-documento",
      "name": "Entrada documento",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "analease-documents",
        "authentication": "headerAuth",
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "id": "preparar-archivo",
      "name": "Preparar archivo",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ],
      "parameters": {
        "jsCode": "\nconst body=$input.first().json.body;\nconst uuid=/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;\nconst mime={'application/pdf':'pdf','image/jpeg':'jpg','image/png':'png'};\nconst fail=()=>[{json:{ok:false,version:1,error:'invalid_file'}}];\nif(!body||body.version!==1||!['upload_id','intake_id','participant_id'].every(k=>typeof body[k]==='string'&&uuid.test(body[k]))||\n typeof body.document_code!=='string'||!/^[a-z_]{1,80}$/.test(body.document_code)||!mime[body.mime_type]||\n typeof body.content_base64!=='string'||body.content_base64.length>13981016||!body.content_base64.length||\n !/^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$/.test(body.content_base64))return fail();\nconst data=Buffer.from(body.content_base64,'base64');\nif(data.length>10485760||!data.length)return fail();\nlet actual=null;\nif(data.subarray(0,5).equals(Buffer.from('%PDF-')))actual='application/pdf';\nif(data.subarray(0,3).equals(Buffer.from([255,216,255])))actual='image/jpeg';\nif(data.subarray(0,8).equals(Buffer.from([137,80,78,71,13,10,26,10])))actual='image/png';\nif(actual!==body.mime_type)return fail();\nconst filename=body.intake_id+'_'+body.participant_id+'_'+body.document_code+'_'+body.upload_id+'.'+mime[actual];\nreturn [{json:{ok:true,file_name:filename,upload_id:body.upload_id},binary:{data:{data:body.content_base64,fileName:filename,fileExtension:mime[actual],mimeType:actual}}}];\n"
      }
    },
    {
      "id": "archivo-válido",
      "name": "Archivo válido",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        480,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "valid",
              "leftValue": "={{ $json.ok }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "guardar-en-sharepoint",
      "name": "Guardar en SharePoint",
      "type": "n8n-nodes-base.microsoftSharePoint",
      "typeVersion": 1,
      "position": [
        720,
        -80
      ],
      "parameters": {
        "resource": "file",
        "operation": "upload",
        "site": {
          "__rl": true,
          "value": "",
          "mode": "list"
        },
        "folder": {
          "__rl": true,
          "value": "",
          "mode": "list"
        },
        "fileName": "={{ $json.file_name }}",
        "fileContents": "data"
      },
      "onError": "continueRegularOutput",
      "alwaysOutputData": true
    },
    {
      "id": "confirmar-guardado",
      "name": "Confirmar guardado",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        -80
      ],
      "parameters": {
        "jsCode": "\nconst response=$input.first().json;\nif(response.error||typeof response.id!=='string'||!response.id||response.id.length>500)\n return [{json:{ok:false,version:1,error:'storage_unavailable'}}];\nreturn [{json:{ok:true,version:1,storage_id:response.id}}];\n"
      }
    },
    {
      "id": "responder-documento",
      "name": "Responder documento",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [
        1200,
        0
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($json) }}",
        "options": {
          "responseCode": "={{ $json.ok ? 200 : ($json.error === 'invalid_file' ? 400 : 502) }}"
        }
      }
    }
  ],
  "connections": {
    "Entrada documento": {
      "main": [
        [
          {
            "node": "Preparar archivo",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Preparar archivo": {
      "main": [
        [
          {
            "node": "Archivo válido",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Archivo válido": {
      "main": [
        [
          {
            "node": "Guardar en SharePoint",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Responder documento",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Guardar en SharePoint": {
      "main": [
        [
          {
            "node": "Confirmar guardado",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Confirmar guardado": {
      "main": [
        [
          {
            "node": "Responder documento",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "saveDataSuccessExecution": "none",
    "saveDataErrorExecution": "none",
    "saveManualExecutions": false,
    "saveExecutionProgress": false
  }
}
